<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 230" width="900" height="230" role="img" aria-label="AI Document Assistant - local RAG application">
  <defs>
    <linearGradient id="card" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#151a38"/>
      <stop offset="1" stop-color="#241c45"/>
    </linearGradient>
    <linearGradient id="border" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#6a6fc9"/>
      <stop offset="0.5" stop-color="#b8325a"/>
      <stop offset="1" stop-color="#e8b84b"/>
    </linearGradient>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="3" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <path id="flow" d="M590,100 L720,100 L850,100"/>
  </defs>

  <rect x="1.5" y="1.5" width="897" height="227" rx="16" fill="url(#card)" stroke="url(#border)" stroke-width="2" stroke-dasharray="14 8">
    <animate attributeName="stroke-dashoffset" from="0" to="-220" dur="8s" repeatCount="indefinite"/>
  </rect>

  <!-- text -->
  <text x="36" y="52" font-family="'Courier New', monospace" font-size="14" letter-spacing="3" fill="#e8b84b">01 / FEATURED PROJECT</text>
  <text x="36" y="92" font-family="Georgia, serif" font-size="32" fill="#ffffff">AI Document Assistant</text>
  <text x="36" y="125" font-family="Arial, Helvetica, sans-serif" font-size="15" fill="#c9cdf5">Local retrieval-augmented generation app that searches</text>
  <text x="36" y="146" font-family="Arial, Helvetica, sans-serif" font-size="15" fill="#c9cdf5">PDF, DOCX and image documents, then answers with sources.</text>

  <!-- tags -->
  <g font-family="'Courier New', monospace" font-size="13" fill="#ffffff">
    <rect x="36" y="172" width="68" height="28" rx="14" fill="#6a6fc9" fill-opacity="0.35"/><text x="70" y="191" text-anchor="middle">Python</text>
    <rect x="112" y="172" width="78" height="28" rx="14" fill="#b8325a" fill-opacity="0.4"/><text x="151" y="191" text-anchor="middle">FastAPI</text>
    <rect x="198" y="172" width="88" height="28" rx="14" fill="#e8b84b" fill-opacity="0.3"/><text x="242" y="191" text-anchor="middle">ChromaDB</text>
    <rect x="294" y="172" width="70" height="28" rx="14" fill="#6a6fc9" fill-opacity="0.35"/><text x="329" y="191" text-anchor="middle">BGE-M3</text>
    <rect x="372" y="172" width="58" height="28" rx="14" fill="#b8325a" fill-opacity="0.4"/><text x="401" y="191" text-anchor="middle">Qwen</text>
  </g>

  <!-- RAG pipeline animation -->
  <line x1="590" y1="100" x2="850" y2="100" stroke="#ffffff" stroke-opacity="0.2" stroke-width="2" stroke-dasharray="4 6"/>
  <g filter="url(#glow)">
    <circle cx="590" cy="100" r="22" fill="#6a6fc9"><animate attributeName="r" values="22;26;22" dur="2.4s" repeatCount="indefinite"/></circle>
    <circle cx="720" cy="100" r="22" fill="#b8325a"><animate attributeName="r" values="22;26;22" dur="2.4s" begin="0.8s" repeatCount="indefinite"/></circle>
    <circle cx="850" cy="100" r="22" fill="#e8b84b"><animate attributeName="r" values="22;26;22" dur="2.4s" begin="1.6s" repeatCount="indefinite"/></circle>
  </g>
  <g font-family="Arial, sans-serif" font-size="12" text-anchor="middle" fill="#c9cdf5">
    <text x="590" y="150">Documents</text>
    <text x="720" y="150">Embeddings</text>
    <text x="850" y="150">Answer + sources</text>
  </g>
  <g font-size="18" text-anchor="middle" fill="#0d1117" font-family="Arial, sans-serif" font-weight="bold">
    <text x="590" y="106">&#9776;</text>
    <text x="720" y="106">&#9670;</text>
    <text x="850" y="106">&#10003;</text>
  </g>

  <!-- travelling data packets -->
  <g fill="#ffffff" filter="url(#glow)">
    <circle r="5"><animateMotion dur="3s" repeatCount="indefinite"><mpath href="#flow"/></animateMotion></circle>
    <circle r="5"><animateMotion dur="3s" begin="1s" repeatCount="indefinite"><mpath href="#flow"/></animateMotion></circle>
    <circle r="5"><animateMotion dur="3s" begin="2s" repeatCount="indefinite"><mpath href="#flow"/></animateMotion></circle>
  </g>
</svg>
