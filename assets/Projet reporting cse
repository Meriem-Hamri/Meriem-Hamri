<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 230" width="900" height="230" role="img" aria-label="Reporting CSE - reporting platform for public financial accounts">
  <defs>
    <linearGradient id="card" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#151a38"/>
      <stop offset="1" stop-color="#2a1c3e"/>
    </linearGradient>
    <linearGradient id="border" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#e8b84b"/>
      <stop offset="0.5" stop-color="#b8325a"/>
      <stop offset="1" stop-color="#6a6fc9"/>
    </linearGradient>
    <linearGradient id="bar" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0" stop-color="#b8325a"/>
      <stop offset="1" stop-color="#e8b84b"/>
    </linearGradient>
  </defs>

  <rect x="1.5" y="1.5" width="897" height="227" rx="16" fill="url(#card)" stroke="url(#border)" stroke-width="2" stroke-dasharray="14 8">
    <animate attributeName="stroke-dashoffset" from="0" to="-220" dur="8s" repeatCount="indefinite"/>
  </rect>

  <text x="36" y="52" font-family="'Courier New', monospace" font-size="14" letter-spacing="3" fill="#e8b84b">02 / INTERNSHIP AT TGR</text>
  <text x="36" y="92" font-family="Georgia, serif" font-size="32" fill="#ffffff">Reporting CSE</text>
  <text x="36" y="125" font-family="Arial, Helvetica, sans-serif" font-size="15" fill="#c9cdf5">Reporting platform for public financial accounts,</text>
  <text x="36" y="146" font-family="Arial, Helvetica, sans-serif" font-size="15" fill="#c9cdf5">developed during my internship at TGR.</text>

  <g font-family="'Courier New', monospace" font-size="13" fill="#ffffff">
    <rect x="36" y="172" width="78" height="28" rx="14" fill="#b8325a" fill-opacity="0.4"/><text x="75" y="191" text-anchor="middle">Angular</text>
    <rect x="122" y="172" width="108" height="28" rx="14" fill="#6a6fc9" fill-opacity="0.35"/><text x="176" y="191" text-anchor="middle">Spring Boot</text>
    <rect x="238" y="172" width="70" height="28" rx="14" fill="#e8b84b" fill-opacity="0.3"/><text x="273" y="191" text-anchor="middle">Oracle</text>
  </g>

  <!-- animated dashboard -->
  <line x1="560" y1="190" x2="860" y2="190" stroke="#ffffff" stroke-opacity="0.25" stroke-width="2"/>
  <g fill="url(#bar)">
    <rect x="575" width="34" rx="5" y="190" height="0"><animate attributeName="height" values="0;60;60;0" keyTimes="0;0.3;0.8;1" dur="5s" repeatCount="indefinite"/><animate attributeName="y" values="190;130;130;190" keyTimes="0;0.3;0.8;1" dur="5s" repeatCount="indefinite"/></rect>
    <rect x="625" width="34" rx="5" y="190" height="0"><animate attributeName="height" values="0;95;95;0" keyTimes="0;0.35;0.8;1" dur="5s" begin="0.3s" repeatCount="indefinite"/><animate attributeName="y" values="190;95;95;190" keyTimes="0;0.35;0.8;1" dur="5s" begin="0.3s" repeatCount="indefinite"/></rect>
    <rect x="675" width="34" rx="5" y="190" height="0"><animate attributeName="height" values="0;75;75;0" keyTimes="0;0.4;0.8;1" dur="5s" begin="0.6s" repeatCount="indefinite"/><animate attributeName="y" values="190;115;115;190" keyTimes="0;0.4;0.8;1" dur="5s" begin="0.6s" repeatCount="indefinite"/></rect>
    <rect x="725" width="34" rx="5" y="190" height="0"><animate attributeName="height" values="0;125;125;0" keyTimes="0;0.45;0.8;1" dur="5s" begin="0.9s" repeatCount="indefinite"/><animate attributeName="y" values="190;65;65;190" keyTimes="0;0.45;0.8;1" dur="5s" begin="0.9s" repeatCount="indefinite"/></rect>
    <rect x="775" width="34" rx="5" y="190" height="0"><animate attributeName="height" values="0;105;105;0" keyTimes="0;0.5;0.8;1" dur="5s" begin="1.2s" repeatCount="indefinite"/><animate attributeName="y" values="190;85;85;190" keyTimes="0;0.5;0.8;1" dur="5s" begin="1.2s" repeatCount="indefinite"/></rect>
  </g>
  <!-- trend line -->
  <polyline points="592,135 642,100 692,120 742,70 792,90" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="400" stroke-dashoffset="400">
    <animate attributeName="stroke-dashoffset" values="400;0;0;400" keyTimes="0;0.5;0.8;1" dur="5s" begin="0.5s" repeatCount="indefinite"/>
  </polyline>
  <text x="710" y="215" text-anchor="middle" font-family="'Courier New', monospace" font-size="12" letter-spacing="2" fill="#c9cdf5">PUBLIC FINANCIAL ACCOUNTS</text>
</svg>
